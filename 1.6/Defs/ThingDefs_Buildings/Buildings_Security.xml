<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef Name="GasVent_Base" ParentName="BuildingBase" Abstract="True">
        <thingClass>GasVents.Building_GasVent</thingClass>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2, 2)</drawSize>
            <damageData>
                <enabled>false</enabled>
            </damageData>
        </graphicData>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <rotatable>true</rotatable>
        <tickerType>Normal</tickerType>
        <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
        <stealable>false</stealable>
        <minifiedDef>MinifiedThing</minifiedDef>
        <designationCategory>Security</designationCategory>
        <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
        <passability>Standable</passability>
        <tickerType>Rare</tickerType>
        <terrainAffordanceNeeded IsNull="True" />

        <overrideMinifiedRot>North</overrideMinifiedRot>
        <minifiedDrawOffset>(0, 0, -0.6)</minifiedDrawOffset>

        <designatorDropdown>GasVent</designatorDropdown>

        <thingCategories>
            <li>BuildingsSecurity</li>
        </thingCategories>

        <researchPrerequisites>
            <li>GasOperation</li>
        </researchPrerequisites>

        <placeWorkers>
            <li>PlaceWorker_NeverAdjacentTrap</li>
        </placeWorkers>

        <costList>
            <Steel>20</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>

        <statBases>
            <Mass>1</Mass>
            <WorkToBuild>1400</WorkToBuild>
            <Flammability>0</Flammability>
        </statBases>

        <placeWorkers>
            <li>Placeworker_AttachedToWall</li>
        </placeWorkers>

        <building>
            <isTrap>true</isTrap>
            <expandHomeArea>false</expandHomeArea>
            <ai_chillDestination>false</ai_chillDestination>
            <isInert>true</isInert>
            <paintable>true</paintable>
            <isAttachment>true</isAttachment>
        </building>

        <comps>
            <li Class="CompProperties_Flickable" />

            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>40</basePowerConsumption>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="GasVent_Base">
        <defName>GasVent_Smoke</defName>
        <label>gas vent (smoke)</label>
        <description>A vent that can be loaded with smoke shells to produce smoke when powered.</description>
        <uiIconPath>Things/Building/Security/GasVent_Smoke_MenuIcon</uiIconPath>
        <graphicData>
            <texPath>Things/Building/Security/GasVent_Smoke</texPath>
        </graphicData>

        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelCapacity>5</fuelCapacity>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
                <initialConfigurableTargetFuelLevel>4</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>4</autoRefuelPercent>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <showFuelGizmo>true</showFuelGizmo>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
                <canEjectFuel>true</canEjectFuel>
                <fuelFilter>
                    <thingDefs>
                        <li>Shell_Smoke</li>
                    </thingDefs>
                </fuelFilter>
            </li>
        </comps>

        <modExtensions>
            <li Class="GasVents.IdentifyingGas">
                <gasType>BlindSmoke</gasType>
            </li>
        </modExtensions>

    </ThingDef>

    <ThingDef MayRequire="Ludeon.Rimworld.Biotech" ParentName="GasVent_Base">
        <defName>GasVent_Tox</defName>
        <label>gas vent (tox)</label>
        <description>A vent that can be loaded with tox gas shells to produce tox gas when powered.</description>
        <uiIconPath>Things/Building/Security/GasVent_Tox_MenuIcon</uiIconPath>
        <graphicData>
            <texPath>Things/Building/Security/GasVent_Tox</texPath>
        </graphicData>

        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelCapacity>5</fuelCapacity>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
                <initialConfigurableTargetFuelLevel>4</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>4</autoRefuelPercent>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <showFuelGizmo>true</showFuelGizmo>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
                <canEjectFuel>true</canEjectFuel>
                <fuelFilter>
                    <thingDefs>
                        <li>Shell_Toxic</li>
                    </thingDefs>
                </fuelFilter>
            </li>
        </comps>

        <modExtensions>
            <li Class="GasVents.IdentifyingGas">
                <gasType>ToxGas</gasType>
            </li>
        </modExtensions>

    </ThingDef>

    <ThingDef MayRequire="Ludeon.Rimworld.Anomaly" ParentName="GasVent_Base">
        <defName>GasVent_Deadlife</defName>
        <label>gas vent (deadlife)</label>
        <description>A vent that can be loaded with deadlife shells to produce deadlife dust when powered.</description>
        <uiIconPath>Things/Building/Security/GasVent_Deadlife_MenuIcon</uiIconPath>
        <graphicData>
            <texPath>Things/Building/Security/GasVent_Deadlife</texPath>
        </graphicData>

        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelCapacity>5</fuelCapacity>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
                <initialConfigurableTargetFuelLevel>4</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>4</autoRefuelPercent>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <showFuelGizmo>true</showFuelGizmo>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
                <canEjectFuel>true</canEjectFuel>
                <fuelFilter>
                    <thingDefs>
                        <li>Shell_Deadlife</li>
                    </thingDefs>
                </fuelFilter>
            </li>
        </comps>

        <modExtensions>
            <li Class="GasVents.IdentifyingGas">
                <gasType>DeadlifeDust</gasType>
            </li>
        </modExtensions>

    </ThingDef>

</Defs>
